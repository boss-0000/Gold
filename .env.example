APP_NAME=RechargeCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Puerto del host para la demo web. En un servidor dedicado, 80 está bien.
# En un VPS que YA usa el 80 para otros proyectos, elija uno libre:
# WEB_PORT=8090

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Con `docker compose up` estos valores ya apuntan a los servicios del compose.
# Para correr SIN Docker (PHP + MySQL/MariaDB local), usar:
#   DB_HOST=127.0.0.1  DB_PORT=3306  DB_PASSWORD=
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=recharge
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Parámetros del laboratorio (opcionales; ver config/demo.php) ---
DEMO_CURRENCY=Bs
DEMO_RAZER_BALANCE=5000000
DEMO_TIMEOUT_RATE=0.20
DEMO_WORKERS=20
